<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
    <ViewDefinitions>
        <View>
            <Name>PSHomebridge.Connection</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.Connection</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Instance Name</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>URL</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Authentication</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>InstanceName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Url</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>Authentication</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.Plugin</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.Plugin</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Plugin</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Installed Version</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Latest Version</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Update Available</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>name</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>installedVersion</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>latestVersion</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>updateAvailable</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.Status.HomebridgeVersion</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.Status.HomebridgeVersion</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Installed Version</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Latest Version</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Update Available</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>installedVersion</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>latestVersion</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>updateAvailable</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.Status.Cpu</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.Status.Cpu</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>CPU Temperature</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Current Load</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <ScriptBlock>$_.cpuTemperature.main</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>currentLoad</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.Status.ChildBridge</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.Status.ChildBridge</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>Name</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Status</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Paired</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Plugin</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Port</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Manually Stopped</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>name</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>status</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>paired</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>plugin</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>port</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>manuallyStopped</PropertyName></TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.Status.Memory</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.Status.Memory</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Total Bytes</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Used Bytes</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Available Bytes</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Swap Used Bytes</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <ScriptBlock>$_.mem.total</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.mem.used</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.mem.available</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.mem.swapused</ScriptBlock>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.Status.Network</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.Status.Network</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Interface</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>State</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Received Bytes/Second</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Transmitted Bytes/Second</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <ScriptBlock>$_.net.iface</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.net.operstate</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.net.rx_sec</ScriptBlock>
                            </TableColumnItem>
                            <TableColumnItem>
                                <ScriptBlock>$_.net.tx_sec</ScriptBlock>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.Status.NodeJs</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.Status.NodeJs</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Current Version</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Latest Version</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>NPM Version</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Architecture</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Update Available</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>currentVersion</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>latestVersion</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>npmVersion</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>architecture</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>updateAvailable</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.Status.ServerInformation</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.Status.ServerInformation</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Service User</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Node.js Version</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Running in Docker</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Insecure Mode</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>serviceUser</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>nodeVersion</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>homebridgeRunningInDocker</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>homebridgeInsecureMode</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.Status.Uptime</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.Status.Uptime</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Host Uptime</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>UI Process Uptime</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>time</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>processUptime</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.Accessory</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.Accessory</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Service Name</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Accessory Type</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Unique ID</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>serviceName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>humanType</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>uniqueId</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.AccessoryLayout</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.AccessoryLayout</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>Room Name</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Service Count</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>name</PropertyName></TableColumnItem>
                            <TableColumnItem><ScriptBlock>@($_.services).Count</ScriptBlock></TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.ServerDiagnostic.Pairing</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.ServerDiagnostic.Pairing</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Display Name</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Paired</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>displayName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>isPaired</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.ServerDiagnostic.PairingList</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.ServerDiagnostic.PairingList</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Display Name</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Category</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Paired</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>displayName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>category</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>_isPaired</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.ServerDiagnostic.SystemNetworkInterface</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.ServerDiagnostic.SystemNetworkInterface</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Interface</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>IPv4 Address</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>MAC Address</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Default</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>ifaceName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>ip4</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>mac</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>default</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.ServerDiagnostic.MatterAccessory</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.ServerDiagnostic.MatterAccessory</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader><Label>Display Name</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Device Type</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Plugin</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Platform</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Manufacturer</Label></TableColumnHeader>
                    <TableColumnHeader><Label>Model</Label></TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem><PropertyName>displayName</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>deviceType</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>plugin</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>platform</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>manufacturer</PropertyName></TableColumnItem>
                            <TableColumnItem><PropertyName>model</PropertyName></TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
        <View>
            <Name>PSHomebridge.Backup</Name>
            <ViewSelectedBy>
                <TypeName>PSHomebridge.Backup</TypeName>
            </ViewSelectedBy>
            <TableControl>
                <TableHeaders>
                    <TableColumnHeader>
                        <Label>Backup ID</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>File Name</Label>
                    </TableColumnHeader>
                    <TableColumnHeader>
                        <Label>Timestamp</Label>
                    </TableColumnHeader>
                </TableHeaders>
                <TableRowEntries>
                    <TableRowEntry>
                        <TableColumnItems>
                            <TableColumnItem>
                                <PropertyName>id</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>fileName</PropertyName>
                            </TableColumnItem>
                            <TableColumnItem>
                                <PropertyName>timestamp</PropertyName>
                            </TableColumnItem>
                        </TableColumnItems>
                    </TableRowEntry>
                </TableRowEntries>
            </TableControl>
        </View>
    </ViewDefinitions>
</Configuration>
